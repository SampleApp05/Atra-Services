DATABASE_URL=postgres://postgres:postgres@localhost:5432/atra_dev
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
PORT=3001

# Chain configuration
SUPPORTED_CHAINS=ethereum,sepolia
DEFAULT_CHAIN=sepolia

# RPC / WS endpoints (required if the chain is in SUPPORTED_CHAINS)
ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR_KEY
ETHEREUM_WS=wss://mainnet.infura.io/ws/v3/YOUR_KEY
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_KEY
SEPOLIA_WS=wss://sepolia.infura.io/ws/v3/YOUR_KEY

# Contract addresses (optional — leave blank if not yet deployed)
# ETHEREUM_RECOVERY_CONTRACT=0x...
# SEPOLIA_RECOVERY_CONTRACT=0x...

# Token / nonce lifetimes (all optional — defaults shown)
ACCESS_TOKEN_TTL=15m        # jsonwebtoken duration string
REFRESH_TOKEN_TTL_DAYS=30   # integer days
NONCE_TTL_MINUTES=5         # integer minutes
